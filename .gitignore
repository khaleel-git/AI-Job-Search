# Ignore everything by default
*

# Allow directory traversal so allowlist patterns can work
!*/

# Keep source/docs and gitignore tracked
!*.py
!*.md
!.gitignore
!**/requirements.txt
!Google-Map/useragents.txt
!Google-Map/tech_searches.txt
!Google-Map/tracked_emails.txt
!Google-Map/tracked_websites.txt

# Explicitly ignore sensitive/config/token files
*.csv
*.json
token.json
credentials.json
.env
.env.*
*.env

# Ignore environment folders/data
venv/
env/
.venv/

# Ignore Chrome profile/session data
chrome_linkedin_profile/
**/chrome_linkedin_profile/

# Python cache artifacts
__pycache__/
*.py[cod]

# Common system/IDE noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# MapLeads web app: static UI is tracked, local data (SQLite DB, attachments) is not
!Google-Map/webapp/static/*.html
!Google-Map/webapp/static/*.css
!Google-Map/webapp/static/*.js
Google-Map/data/
